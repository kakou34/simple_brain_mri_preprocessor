Bootstrap: docker
From: nvidia/cuda:11.7.1-cudnn8-runtime-ubuntu22.04  # Use Ubuntu 22.04 for Python 3.10

%setup
    cp -r . ${APPTAINER_ROOTFS}/opt/mri_tool

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIP_NO_CACHE_DIR=1
    
    # 1. System dependencies (minimal)
    apt-get update && apt-get install -y --no-install-recommends \
        python3-pip python3-dev python3.10 git wget bc cmake g++ \
        libgl1-mesa-glx libglu1-mesa libxt6 libx11-6 \
        libquadmath0 libgomp1 && \
        rm -rf /var/lib/apt/lists/*
    
    # 2. Ensure python3 points to Python 3.10
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1
    
    # 3. Install PyTorch with compatible Python
    python3 -m pip install --no-cache-dir \
        torch==2.0.1+cu117 torchvision==0.15.2+cu117 \
        --index-url https://download.pytorch.org/whl/cu117
    
    # 4. Install FSL (minimal)
    wget -q https://fsl.fmrib.ox.ac.uk/fsldownloads/fslinstaller.py
    python3 fslinstaller.py -d /opt/fsl --no_checksum -q --minimal
    
    # 5. Install Python packages
    python3 -m pip install --no-cache-dir \
        nibabel numpy antspyx \
        git+https://github.com/MIC-DKFZ/HD-BET.git
    
    # 6. Cleanup FSL
    find /opt/fsl -name "*.a" -delete
    find /opt/fsl -name "*.pdf" -delete
    find /opt/fsl -name "*.html" -delete
    rm -rf /opt/fsl/doc /opt/fsl/src /opt/fsl/tcl
    
    # 7. Clean system
    python3 -m pip cache purge
    apt-get clean
    rm -rf /tmp/* /var/tmp/*

%environment
    export FSLDIR=/opt/fsl
    export PATH=$FSLDIR/bin:$PATH
    export FSLOUTPUTTYPE=NIFTI_GZ
    export LD_LIBRARY_PATH=$FSLDIR/lib:$LD_LIBRARY_PATH
    export PYTHONPATH=/opt/mri_tool:$PYTHONPATH

%runscript
    exec python3 /opt/mri_tool/main.py "$@"